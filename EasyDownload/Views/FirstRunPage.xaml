<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyDownload.Views.FirstRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EasyDownload.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                MaxWidth="520"
                Padding="32,28,32,24"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 步骤指示 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Border x:Name="Dot0" Width="8" Height="8" CornerRadius="4" />
                    <Border x:Name="Dot1" Width="8" Height="8" CornerRadius="4" />
                    <Border x:Name="Dot2" Width="8" Height="8" CornerRadius="4" />
                    <Border x:Name="Dot3" Width="8" Height="8" CornerRadius="4" />
                </StackPanel>

                <TextBlock x:Name="StepText"
                           Grid.Row="1"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <!-- ===== 步骤 1：欢迎 ===== -->
                <StackPanel x:Name="Step0" Grid.Row="2" Spacing="12" Margin="0,20,0,8">
                    <FontIcon Glyph="&#xE896;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="40"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="欢迎使用 EasyDownload"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="多线程下载器 · 支持 32 线程与断点续传&#x0a;内置浏览器，网页里的下载会自动接管"
                               TextWrapping="WrapWholeWords"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- ===== 步骤 2：主题 ===== -->
                <StackPanel x:Name="Step1" Grid.Row="2" Spacing="12" Margin="0,20,0,8" Visibility="Collapsed">
                    <TextBlock Text="选择外观"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="随时可以在设置里改"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PickLight"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Click="PickLight_Click"
                                Height="74">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
                                <TextBlock Text="浅色" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PickDark"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="PickDark_Click"
                                Height="74">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
                                <TextBlock Text="深色" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- ===== 步骤 3：下载设置 ===== -->
                <StackPanel x:Name="Step2" Grid.Row="2" Spacing="14" Margin="0,20,0,8" Visibility="Collapsed">
                    <TextBlock Text="下载设置"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />

                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="线程数" VerticalAlignment="Center" />
                            <TextBlock x:Name="WizThreadText" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                        <Slider x:Name="WizThreadSlider"
                                Minimum="1" Maximum="32" StepFrequency="1"
                                ValueChanged="WizThread_Changed" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="下载目录" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WizFolderBox" Grid.Column="0" />
                            <Button Grid.Column="1" Content="浏览" Click="WizBrowse_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ===== 步骤 4：完成 ===== -->
                <StackPanel x:Name="Step3" Grid.Row="2" Spacing="12" Margin="0,20,0,8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE73E;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="40"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="一切就绪"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="设置完成，开始使用吧"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 底部按钮 -->
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PrevBtn"
                            Grid.Column="0"
                            Content="上一步"
                            Click="Prev_Click" />
                    <Button x:Name="NextBtn"
                            Grid.Column="2"
                            Content="下一步"
                            Click="Next_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
