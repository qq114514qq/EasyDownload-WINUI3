<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyDownload.Views.BrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EasyDownload.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Padding="8,6,8,6" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackBtn"
                    Grid.Column="0"
                    Click="Back_Click"
                    ToolTipService.ToolTip="后退"
                    Padding="9"
                    Background="Transparent"
                    BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>

            <Button x:Name="ForwardBtn"
                    Grid.Column="1"
                    Click="Forward_Click"
                    ToolTipService.ToolTip="前进"
                    Padding="9"
                    Background="Transparent"
                    BorderThickness="0">
                <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>

            <Button x:Name="RefreshBtn"
                    Grid.Column="2"
                    Click="Refresh_Click"
                    ToolTipService.ToolTip="刷新"
                    Padding="9"
                    Background="Transparent"
                    BorderThickness="0">
                <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>

            <TextBox x:Name="AddressBox"
                     Grid.Column="3"
                     PlaceholderText="输入网址，回车打开"
                     VerticalAlignment="Center"
                     KeyDown="AddressBox_KeyDown" />

            <Button x:Name="GoBtn"
                    Grid.Column="4"
                    Content="打开"
                    Click="Go_Click"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- 多标签 -->
        <TabView x:Name="Tabs"
                 Grid.Row="1"
                 IsAddTabButtonVisible="True"
                 CanDragTabs="False"
                 AddTabButtonClick="Tabs_AddTabClick"
                 TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged" />
    </Grid>
</UserControl>
