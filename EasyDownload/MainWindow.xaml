<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EasyDownload.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EasyDownload"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root">

        <!-- ============ 自定义标题栏（WinUI 风格：可拖动区域 + 右侧系统按钮） ============ -->
        <Grid x:Name="AppTitleBar"
              Height="48"
              VerticalAlignment="Top"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Spacing="10">
                <FontIcon Glyph="&#xE896;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="EasyDownload"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <!-- 右侧留 150 给系统最小化/最大化/关闭按钮 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="0,0,150,0"
                        VerticalAlignment="Center"
                        Spacing="4">
                <Button x:Name="ThemeButton"
                        Click="ThemeButton_Click"
                        ToolTipService.ToolTip="切换浅色 / 深色"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0">
                    <FontIcon x:Name="ThemeIcon"
                              Glyph="&#xE706;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 主体：NavigationView + Frame ============ -->
        <Grid Margin="0,48,0,0">
            <NavigationView x:Name="Nav"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            PaneDisplayMode="Left"
                            OpenPaneLength="180"
                            SelectionChanged="Nav_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NavHome"
                                        Content="首页"
                                        Tag="home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavDownloads"
                                        Content="下载"
                                        Tag="downloads">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavSettings"
                                        Content="设置"
                                        Tag="settings">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Frame x:Name="Host" />
            </NavigationView>
        </Grid>

        <!-- ============ 首次运行引导覆盖层（第二次起不再显示） ============ -->
        <Grid x:Name="FirstRunHost"
              Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

    </Grid>
</Window>
